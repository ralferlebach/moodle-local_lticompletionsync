{{!
    @template local_lticompletionsync/managed_notice

    Explanatory completion state of a provider-managed external tool activity, shown to a learner instead of the
    manual "Mark as done" control (which this learner cannot use: completion is set by the external tool).

    Context variables required for this template:
    * cmid - int, course module id
    * done - bool, the native completion state is complete
    * activityname - string, name of the activity (plain text)

    Example context (json):
    {
        "cmid": 12,
        "done": true,
        "activityname": "Simulation lab"
    }
}}
<div class="local-lticompletionsync-managed alert alert-info mt-2" role="note" data-region="local-lticompletionsync-managed" data-cmid="{{cmid}}">
    <p class="mb-1">
        <strong>{{#str}} managednotice_title, local_lticompletionsync {{/str}}</strong>
        {{#done}}<span data-state="done">{{#str}} managednotice_done, local_lticompletionsync {{/str}}</span>{{/done}}
        {{^done}}<span data-state="todo">{{#str}} managednotice_todo, local_lticompletionsync {{/str}}</span>{{/done}}
    </p>
    <p class="mb-0">{{#str}} managednotice_explain, local_lticompletionsync, {{activityname}} {{/str}}</p>
</div>
